create database SpaRelajarnos;
go

use SpaRelajarnos;
go

CREATE TABLE Cliente
(
Id int identity(1,1) primary key,
Documento varchar(20) not null,
Nombre varchar(50) not null,
Apellido varchar(50) not null,
Telefono int not null,
Correo varchar(50) not null,
Direccion varchar(100) not null,
FechaRegistro date not null,
CONSTRAINT Documento_Unico_Cliente UNIQUE (Documento)
);
go

CREATE TABLE Cargo
(
Id int identity(1,1) primary key,
Nombre varchar(50) not null
);
go

CREATE TABLE Ciudad
(
Id int identity(1,1) primary key not null,
Nombre varchar(20) not null
);
go

CREATE TABLE Sede
(
Id int identity(1,1) primary key,
Nombre varchar(20) not null,
Direccion varchar(100) not null,
IdCiudad int foreign key (IdCiudad) References Ciudad(Id) not null
);
go

CREATE TABLE Empleado
(
Id int identity(1,1) primary key,
Documento varchar(20) not null,
Nombre varchar(50) not null,
Apellido varchar(50) not null,
Telefono int not null,
Correo varchar(50) not null,
Direccion varchar(100) not null,
FechaContratacion date not null,
Salario decimal(10,2) not null,
IdCargo int foreign key (IdCargo) References Cargo(Id) not null,
IdSede int foreign key (IdSede) References Sede(Id) not null,
CONSTRAINT Documento_Unico_Empleado UNIQUE (Documento)
);
go

CREATE TABLE MetodoPago
(
Id int identity(1,1) primary key,
Nombre varchar(20)
);
go

CREATE TABLE TipoServicio
(
Id int identity(1,1) primary key,
Nombre varchar(50) not null
);
go

CREATE TABLE Servicio
(
Id int identity(1,1) primary key,
Nombre varchar(50) not null,
Descripcion varchar(200) not null,
Precio  decimal(10,2) not null,
IdTipoServicio int foreign key (IdTipoServicio) References TipoServicio(Id) not null
);
GO

CREATE TABLE Estado
(
Id int identity(1,1) primary key,
Nombre varchar(20) not null
);
go

CREATE TABLE FacturaReserva
(
Numero int primary key,
Fecha date not null,
IdMetodoPago int foreign key (IdMetodoPago) References MetodoPago(Id) not null,
IdCliente int foreign key (IdCliente) References Cliente(Id) not null,
IdEmpleado int foreign key (IdEmpleado) References Empleado(Id) not null
);
go

CREATE TABLE Reserva
(
Id int identity(1,1) primary key,
Fecha date not null,
Hora time not null,
IdSede int foreign key (IdSede) References Sede(Id) not null,
IdFacturaReserva int foreign key (IdFacturaReserva) References FacturaReserva(Numero) not null,
IdEstado int foreign key (IdEstado) References Estado(Id) not null
);
go

CREATE TABLE DetalleFacturaReserva
(
Codigo int identity(1,1) primary key,
Numero int foreign key (Numero) References FacturaReserva(Numero) not null,
Cantidad int not null,
ValorUnitario decimal(10,2) not null,
IdServicio int foreign key (IdServicio) References Servicio(Id) not null
);
go

CREATE TABLE TipoProducto
(
Id int identity(1,1) primary key,
Nombre varchar(20) not null
);
go

CREATE TABLE Producto
(
Id int identity(1,1) primary key,
Nombre varchar(20) not null,
Precio  decimal(10,2) not null,
IdTipoProducto int foreign key (IdTipoProducto) References TipoProducto(Id) not null
);
go

CREATE TABLE FacturaProducto
(
Numero int primary key,
Fecha date not null,
IdMetodoPago int foreign key (IdMetodoPago) References MetodoPago(Id) not null,
IdCliente int foreign key (IdCliente) References Cliente(Id) not null,
IdEmpleado int foreign key (IdEmpleado) References Empleado(Id) not null
);
go

CREATE TABLE DetalleFacturaProducto
(
Codigo int identity(1,1) primary key,
Numero int foreign key (Numero) References FacturaProducto(Numero) not null,
Cantidad int not null,
ValorUnitario decimal(10,2) not null,
IdProducto int foreign key (IdProducto) References Producto(Id) not null,
);
GO

CREATE TABLE Usuario
(
Id int identity(1,1) primary key,
IdEmpleado INT FOREIGN KEY (IdEmpleado) REFERENCES Empleado(Id) not null,
UserName VARCHAR(20) not null,
Clave NVARCHAR(MAX) not null,
Salt NVARCHAR(MAX) not null
);
GO

CREATE TABLE Perfil
(
Id int identity(1,1) primary key,
Nombre VARCHAR(20) not null,
PaginaNavegar varchar(20) not null
);
GO

CREATE TABLE Usuario_Perfil
(
Id int identity(1,1) primary key,
IdUsuario INT FOREIGN KEY (IdUsuario) REFERENCES Usuario(Id) not null,
IdPerfil INT FOREIGN KEY (IdPerfil) REFERENCES Perfil(Id) not null,
Activo BIT not null
);
GO
